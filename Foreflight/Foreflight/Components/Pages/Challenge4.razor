@page "/challenge4"
@using BlazorBootstrap;

@using Foreflight.Components.Services
@rendermode InteractiveServer

<PageTitle>Challenge 3</PageTitle>

<h1>Challenge 3</h1>

<h2>Our approach:</h2>
<ul>
    <li>Run StepFilter</li>
    <li>For each remaining point (x1,y1), try every other point (x2,y2) to form a line.</li>
    <li>Compute slope m = (y1 - y2)/(x1 - x2)</li>
    <li>Compute intercept b = y1 - m * x1</li>
    <li>Keep the point if any positive-slope </li>
    <li>Discard otherwise.</li>
    <li>Complexity O(n²)</li>

</ul>

<div class="row g-4">
    <div class="col-auto text-center">
        <h5>AKIT.csv</h5>
        <ScatterChart @ref="scatterChart1" Width="360" Height="300" />
    </div>
    <div class="col-auto text-center">
        <h5>BRYU.csv</h5>
        <ScatterChart @ref="scatterChart2" Width="360" Height="300" />
    </div>
    <div class="col-auto text-center">
        <h5>WZAU.csv</h5>
        <ScatterChart @ref="scatterChart3" Width="360" Height="300" />
    </div>
</div>

@code {
    private ScatterChart scatterChart1 = default!;
    private ScatterChart scatterChart2 = default!;
    private ScatterChart scatterChart3 = default!;

    private ScatterChartOptions chartOptions = new();
    private ChartData chartData1 = default!;
    private ChartData chartData2 = default!;
    private ChartData chartData3 = default!;

    protected override void OnInitialized()
    {
        chartData1 = BuildChartData("Challenges/challenge_4/AKIT.csv");
        chartData2 = BuildChartData("Challenges/challenge_4/BRYU.csv");
        chartData3 = BuildChartData("Challenges/challenge_4/WZAU.csv");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await scatterChart1.InitializeAsync(chartData1, chartOptions);
            await scatterChart2.InitializeAsync(chartData2, chartOptions);
            await scatterChart3.InitializeAsync(chartData3, chartOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private ChartData BuildChartData(string path)
    {
        try
        {
            var csvService = new CsvService(path);
            var filterService = new FilterService(csvService.CsvParser());
            filterService.ClimbRateFilterWithTakeOffDist(6000);
            var filtered = filterService.dataPoints.Select(p => new ScatterChartDataPoint(p.x, p.y)).ToList();

            var dataset = new ScatterChartDataset
            {
                Label = "Data",
                Data = filtered,
                BorderWidth = 2,
                HoverBorderWidth = 4,
            };

            return new ChartData
            {
                Datasets = new() { dataset }
            };
        }
    catch (Exception)
        {
            throw new Exception($"Error building chart data from {path}");
        }
    }
}