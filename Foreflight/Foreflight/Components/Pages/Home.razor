@page "/"
@using BlazorBootstrap
@using Foreflight.Components.Services
@rendermode InteractiveServer

<PageTitle>Challenge 1</PageTitle>

<h1>Challenge 1</h1>

<h2>How the CSV service and chart rendering work</h2>
<div class="mb-3">
    <ul>
        <li>Constructed with a relative path: "Challenges/challenge_1_2/GWJI.csv".</li>
        <li>CsvParser():
            <ul>
                <li>Checks File.Exists(path)</li>
                <li>Reads line by line with StreamReader.</li>
                <li>Skips the first line, which we assume is a header</li>
                <li>Splits each remaining line</li>
                <li>Makes (x, y) tuples in a List.</li>
            </ul>
        </li>
        <li>CsvScatterChartParser():
            <ul>
                <li>Calls CsvParser() to get List of tuples</li>
                <li>Wraps each tuple as ScatterChartDataPoint (BlazorBootstrap type).</li>
                <li>Returns List of ScatterChartDataPoint to the page.</li>
            </ul>
        </li>
    </ul>

<ScatterChart @ref="scatterChart" Width="560" Height="480" />
</div>
@code {
    private ScatterChart scatterChart = default!;
    private ScatterChartOptions scatterChartOptions = default!;
    private ChartData chartData = default!;

    protected override void OnInitialized()
    {
        var service = new CsvService("Challenges/challenge_1_2/GWJI.csv");

        var data = new ScatterChartDataset{
            Label = "Data",
            Data = GetData(),
            BorderWidth = 2,
            HoverBorderWidth = 4,
        };

        chartData = new ChartData
        {
            Datasets = new()
            {
                data
            }
        };

        scatterChartOptions = new() { };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await scatterChart.InitializeAsync(chartData, scatterChartOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private List<ScatterChartDataPoint?> GetData()
    {
        var csvService = new CsvService("Challenges/challenge_1_2/GWJI.csv");
        return csvService.CsvScatterChartParser();
    }
}