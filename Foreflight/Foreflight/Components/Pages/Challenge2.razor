@page "/challenge2"
@using BlazorBootstrap;

@using Foreflight.Components.Services
@rendermode InteractiveServer

<PageTitle>Challenge 2</PageTitle>

<h1>Challenge 2</h1>

<h2>Our approach:</h2>

<div class="mb-3">
    <ul>
        <li>Iterate through the points in order.</li>
        <li>Track the highest altitude reached so far (top).</li>
        <li>Add a point only if its y >= top</li>
        <li>Result: All non-increasing steps are removed.</li>
    </ul>
</div>


<ScatterChart @ref="scatterChart" Width="560" Height="480" />

@code {
    private ScatterChart scatterChart = default!;
    private ScatterChartOptions scatterChartOptions = default!;
    private ChartData chartData = default!;

    protected override void OnInitialized()
    {
        var data = new ScatterChartDataset{
            Label = "Data",
            Data = GetData(),
            BorderWidth = 2,
            HoverBorderWidth = 4,
        };

        chartData = new ChartData
        {
            Datasets = new()
            {
                data
            }
        };

        scatterChartOptions = new() { };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await scatterChart.InitializeAsync(chartData, scatterChartOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private List<ScatterChartDataPoint> GetData()
    {
        var csvService = new CsvService("Challenges/challenge_1_2/GWJI.csv");
        FilterService filterService = new FilterService(csvService.CsvParser());
        filterService.StepFilter();

        return filterService.dataPoints.Select(point => new ScatterChartDataPoint(point.x, point.y)).ToList();
    }
}